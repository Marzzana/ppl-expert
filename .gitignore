node_modules/
dist/

# The course's own repositories, cloned by `npm run setup`. Only needed to re-run
# the content pipeline — the generated content in public/ is committed, so a plain
# install never needs this.
sources/

# Translation worksheets are scratch and are regenerated from the pipeline, but the
# two authoring guides are real documentation — the README points at them, so they
# must survive a fresh clone.
work/*
!work/GUIDE.md
!work/GUIDE-CODE.md

# Generated reports
verification-report.md

# TypeScript incremental build cache
tsconfig.tsbuildinfo
